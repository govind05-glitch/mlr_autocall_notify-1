# MongoDB Atlas
MONGO_URL=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
DB_NAME=auto_call_notification_db

# Security: generate a random value of 32+ characters
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated frontend origin(s). Example:
# CORS_ORIGINS=https://your-frontend.vercel.app
CORS_ORIGINS=http://localhost:3000

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
